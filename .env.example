APP_NAME=Matex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://matex-dev.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=matex
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- QXI/QDoc gateway (port 24079) — maintainPurchaseOrder, receivePurchaseOrder. TEST env. ---
QAD_BASE_URL=http://qadeesdi.site:24079/qxi/services/QdocWebService
QAD_DOMAIN=7000
QAD_VERSION=eB2_3
QAD_USERNAME=
QAD_PASSWORD=

# --- WSA (port 25079) — read-only item/supplier master queries. PRODUCTION env, no auth needed. ---
QAD_WSA_URL=http://qadeesdi.site:25079/wsa/wsaprod
QAD_WS_NAMESPACE=http://ws.imi.co.id/wsaprod

# --- Receiving kill switch — see config/qad.php ---
QAD_RECEIVING_ENABLED=false

# --- Business defaults shared by PO creation + receiving (config/qad.php "defaults") ---
# Uncomment to override; see config/qad.php for the built-in fallback values.
# QAD_SITE=7101
# QAD_LOCATION=RAWMAT
# QAD_PO_TYPE=P
# QAD_ACCOUNT=504006
# QAD_DAYBOOKSET=AP-SET
# QAD_CREDIT_TERMS=45D
# QAD_CURRENCY=IDR
# QAD_TAX_CODE=PPN
# QAD_TAX_ENV=IDN
# QAD_REQUESTER_ID=MFG
# QAD_PURCHASE_COST=450.00000
